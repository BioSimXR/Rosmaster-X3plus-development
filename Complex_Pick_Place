import subprocess
import time

def get_active_container_name(image_keyword="ros-melodic"):
    """
    Finds the name of the active Docker container matching the given image keyword.
    """
    try:
        # Run 'docker ps' with a format filter to return only the Image and Name
        cmd = ["docker", "ps", "--format", "{{.Image}} {{.Names}}"]
        output = subprocess.check_output(cmd, text=True).strip()
        
        # Loop through each running container line
        for line in output.split("\n"):
            if image_keyword in line:
                container_name = line.split()[-1]
                return container_name
                
    except Exception as e:
        print(f"Error fetching container name: {e}")
    
    return None
