import subprocess
import time

# 1. Check if container exists/is running, or start it directly
print("Ensuring Docker container is running...")

# Get ID/Name of any existing container (running or stopped)
try:
    container_id = subprocess.check_output(
        ["docker", "ps", "-a", "-q", "--filter", "ancestor=yahboomtechnology/ros-melodic:4.0.1"],
        text=True
    ).strip().split('\n')[0]
    
    # Start the container if it's stopped
    subprocess.run(["docker", "start", container_id])
    CONTAINER_NAME = container_id
    print(f"✅ Connected to container ID: {CONTAINER_NAME}")
    
except Exception as e:
    raise RuntimeError("❌ Could not find or start the Yahboom Docker container. Please run './run_docker.sh' once in terminal first!")

# 2. Helper function
def run_in_docker(ros_cmd):
    full_cmd = (
        "source /opt/ros/melodic/setup.bash && "
        "source /root/yahboomcar_ws/devel/setup.bash && "
        f"{ros_cmd}"
    )
    return subprocess.Popen([
        "docker", "exec", CONTAINER_NAME,
        "bash", "-c", full_cmd
    ])


# 1. Launch LiDAR Driver

lidar_proc = run_in_docker("roslaunch ydlidar_ros_driver TG.launch")

# 2. Launch Astra Camera Driver 

camera_proc = run_in_docker("roslaunch astra_camera astra.launch")

# 3. Publish Static TF (base_link -> laser)

tf_proc = run_in_docker("rosrun tf static_transform_publisher 0.1 0 0.15 0 0 0 base_link laser 100")

# 4. Launch MoveIt for the Arm 

moveit_proc = run_in_docker("roslaunch transbot_moveit_config demo.launch")

# Wait for hardware nodes to initialize fully 

print("Waiting 5 seconds for drivers to initialize...")

time.sleep(5)

print("Drivers launched successfully!")
