print("Starting Docker environment...")
docker_start = subprocess.Popen(["/bin/bash", "./run_docker.sh"])

CONTAINER_NAME = get_active_container_name("ros-melodic")

def run_in_docker(ros_cmd):
    full_cmd = (
        f"source /opt/rps/melodic/setup.bash && "
        f"source /root/yahboomcar_ws/devel/setup.bash && "
        f"{ros_cmd}"
    )
    return subprocess.Popen([
        "docker", "exec", -d, CONTAINER_NAME,
        "bash", "-c", full_cmd
    ])

# 1. Launch LiDAR Driver

