import actionlib
import moveit_commander
import rospy
import tf2_ros
from geometry_msgs.msg import PoseStamped
from move_base_msgs.msg import MoveBaseAction, MoveBaseGoal

# Initialize Jupyter as a ROS node
rospy.init_node("jupyter_master_pipeline", anonymous=True)

# Navigation Action Client
nav_client = actionlib.SimpleActionClient("move_base", MoveBaseAction)

# MoveIt Group Commanders
moveit_commander.roscpp_initialize([])
arm_group = moveit_commander.MoveGroupCommander("arm")
gripper_group = moveit_commander.MoveGroupCommander("gripper")

# TF Listener
tf_buffer = tf2_ros.Buffer()
tf_listener = tf2_ros.TransformListener(tf_buffer)

print("ROS node and MoveIt commanders initialized!")
______________________________________________________________________________
print("--- STEP 1: Detecting Target Object ---")

target_found = False
target_trans = None

while not rospy.is_shutdown() and not target_found:
    try:
        # Lookup transform from map frame to target block
        target_trans = tf_buffer.lookup_transform(
            "map", "target_block", rospy.Time(0), rospy.Duration(1.0)
        )
        target_found = True
        print(
            f"Target block located at X: {target_trans.transform.translation.x:.2f}, "
            f"Y: {target_trans.transform.translation.y:.2f}"
        )
    except (
        tf2_ros.LookupException,
        tf2_ros.ConnectivityException,
        tf2_ros.ExtrapolationException,
    ):
        print("Searching for block frame in TF...")
        rospy.sleep(1.0)
______________________________________________________________________________
print("--- STEP 2: Navigating Base to Object ---")

goal = MoveBaseGoal()
goal.target_pose.header.frame_id = "map"
goal.target_pose.header.stamp = rospy.Time.now()

# Offset target by -0.4 meters so the base stops just in front of the block
goal.target_pose.pose.position.x = target_trans.transform.translation.x - 0.4
goal.target_pose.pose.position.y = target_trans.transform.translation.y
goal.target_pose.pose.orientation.w = 1.0

