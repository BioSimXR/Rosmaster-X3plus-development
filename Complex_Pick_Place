import subprocess
import time

print("Starting hardware drivers...")

# 1. Launch LiDAR Driver
lidar_proc = subprocess.Popen(["roslaunch", "ydlidar_ros_driver", "TG.launch"])

# 2. Launch Astra Camera Driver
camera_proc = subprocess.Popen(["roslaunch", "astra_camera", "astra.launch"])

# 3. Publish Static TF (base_link -> laser)
tf_proc = subprocess.Popen([
    "rosrun", "tf", "static_transform_publisher",
    "0.1", "0", "0.15", "0", "0", "0", "base_link", "laser", "100"
])

# 4. Launch MoveIt for the Arm
moveit_proc = subprocess.Popen(["roslaunch", "transbot_moveit_config", "demo.launch"])

# Wait for hardware nodes to initialize fully
print("Waiting 5 seconds for drivers to initialize...")
time.sleep(5)
print("Drivers launched successfully!")
