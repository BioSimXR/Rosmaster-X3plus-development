rospy.sleep(2.0)
print("Arm in position for fine camera inspection.")
_________________________________________________________________________________
print("--- STEP 4: Executing Pick Routine ---")

# 1. Open Gripper
print("Opening gripper...")
gripper_group.set_named_target("open")
gripper_group.go(wait=True)

# 2. Descend to object
print("Lowering arm...")
current_pose = arm_group.get_current_pose().pose
current_pose.position.z -= 0.10
arm_group.set_pose_target(current_pose)
arm_group.go(wait=True)

# 3. Close Gripper
print("Grasping object...")
gripper_group.set_named_target("close")
gripper_group.go(wait=True)

# 4. Lift Object
print("Lifting object...")
current_pose.position.z += 0.20
arm_group.set_pose_target(current_pose)
arm_group.go(wait=True)

print("Pick-and-place complete!")
